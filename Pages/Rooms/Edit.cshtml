@page "{id:int}"
@model wt_lab5_5razor_pravotorova.Pages.Rooms.EditModel
@{
    ViewData["Title"] = "Редактирование";
}

<div class="container form-page">
    <div class="form-wrap">
        <h1>Редактирование</h1>
        <p class="form-sub">Номер @Model.Room.Number</p>

        <form method="post">
            <input type="hidden" asp-for="Room.Id" />
            <div class="form-group">
                <label asp-for="Room.Number">Номер комнаты</label>
                <input asp-for="Room.Number" />
            </div>
            <div class="form-group">
                <label asp-for="Room.Category">Категория</label>
                <input asp-for="Room.Category" />
            </div>
            <div class="form-group">
                <label asp-for="Room.Capacity">Вместимость</label>
                <input asp-for="Room.Capacity" type="number" />
            </div>
            <div class="form-group">
                <label asp-for="Room.PricePerNight">Цена за ночь (₽)</label>
                <input asp-for="Room.PricePerNight" type="number" step="0.01" />
            </div>
            <div class="form-group">
                <label asp-for="Room.ImageUrl">Ссылка на фото</label>
                <input asp-for="Room.ImageUrl" />
            </div>
            <div class="form-group">
                <label asp-for="Room.Description">Описание</label>
                <textarea asp-for="Room.Description"></textarea>
            </div>
            <div class="form-check">
                <input asp-for="Room.IsAvailable" type="checkbox" />
                <label asp-for="Room.IsAvailable">Свободен</label>
            </div>
            <div class="form-actions">
                <a asp-page="/Rooms/Index" class="btn btn-outline">Назад</a>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </div>
        </form>
    </div>
</div>