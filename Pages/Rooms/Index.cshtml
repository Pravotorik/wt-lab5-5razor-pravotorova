@page
@model wt_lab8_8razor_postgresql_pravotorova.Pages.Rooms.IndexModel
@{
    ViewData["Title"] = "Номера";
}

<div class="container page-container">
    <div class="page-head">
        <div>
            <h1>Каталог номеров</h1>
            <p>@Model.Rooms.Count вариантов для вашего отдыха</p>
        </div>
        <div class="page-actions">
            <a asp-page="/Rooms/Book" class="btn btn-accent">Забронировать</a>
            <a asp-page="/Rooms/Create" class="btn btn-primary">+ Добавить</a>
        </div>
    </div>

    <form method="get" class="search-form mb-4">
        <input type="text" name="Search" value="@Model.Search" placeholder="Поиск по номеру или категории..." />
        <button type="submit">Найти</button>
    </form>

    <div class="cards">
        @foreach (var room in Model.Rooms)
        {
        <article class="room-card">
            <div class="room-card__image">
                <img src="@room.ImageUrl" alt="Номер @room.Number" />
                <span class="room-card__badge">№ @room.Number</span>
                <span class="room-card__status @(room.IsAvailable ? "available" : "busy")">
                    @(room.IsAvailable ? "Свободен" : "Занят")
                </span>
            </div>
            <div class="room-card__body">
                <div class="room-card__category">@room.Category</div>
                <h3 class="room-card__title">Номер @room.Number</h3>
                <p class="room-card__desc">@room.Description</p>
                <div class="room-card__footer">
                    <div class="room-card__price">@room.PricePerNight ₽ <span>/ ночь</span></div>
                    <a asp-page="/Rooms/Details" asp-route-id="@room.Id" class="room-card__link">Подробнее →</a>
                </div>
            </div>
        </article>
        }
    </div>
</div>